# Data & Fixtures
# Ignore all raw IQ and large WAV files, but allow ground_truth and metadata
*.iq
*.wav
*.bin
*.raw
*.sigmf-data

# Explicitly allow metadata and truth in fixtures
!fixtures/**/metadata.json
!fixtures/**/ground_truth.json
!fixtures/**/*.sigmf-meta

